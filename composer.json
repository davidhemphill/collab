{
    "name": "hemp/collab",
    "description": "A pure-PHP Yjs collaboration server speaking the Hocuspocus provider protocol.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "yjs",
        "crdt",
        "hocuspocus",
        "collaboration",
        "websocket"
    ],
    "require": {
        "php": "^8.4",
        "guzzlehttp/psr7": "^2.7",
        "hemp/yjs": "^0.1",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "psr/log": "^3.0",
        "ratchet/rfc6455": "^0.4",
        "react/event-loop": "^1.5",
        "react/socket": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^4.3"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../yjs-php",
            "options": {
                "symlink": true,
                "versions": {
                    "hemp/yjs": "0.1.0"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Hemp\\Collab\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hemp\\Collab\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint --parallel",
        "test:lint": "pint --parallel --test",
        "test:unit": "pest",
        "test": [
            "@test:lint",
            "@test:unit"
        ],
        "fixtures": "node tools/oracle/generate-transcripts.mjs"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Hemp\\Collab\\Laravel\\CollabServiceProvider"
            ]
        }
    }
}
